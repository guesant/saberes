{
  "$schema": "https://json.schemastore.org/deno.json",
  "workspace": ["./packages/*"],
  "imports": {
    "@std/path": "jsr:@std/path@1.1.6"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "useTabs": true,
    "lineWidth": 100,
    "exclude": ["dist", "node_modules", ".cache"]
  },
  "lint": {
    "exclude": ["dist", "node_modules", ".cache"]
  },
  "tasks": {
    "build": "deno task database:schema-docs && vite --config .config/vite.config.ts build",
    "dev": "vite --config .config/vite.config.ts --host 0.0.0.0",
    "typecheck": "deno run --allow-all npm:typescript@5.9.3/tsc --project .config/tsconfig.json --noEmit",
    "check": "deno task quality:check",
    "quality:check": "deno task quality:check:fast",
    "quality:check:fast": "deno task check:format && deno task check:lint && deno task typecheck && deno task test && deno task architecture:test && deno task file:conventions",
    "quality:check:heavy": "deno task quality:check:fast && deno task dependencies:checksums:check && deno task db:format:check && deno task stylelint && deno task markdownlint && deno task cspell && deno task docs:links && deno task commit:check && deno task ast-grep && deno task comments && deno task architecture:check && deno task sbom:check && deno task security:check && deno task duplication && deno task dead-code && deno task build",
    "heavy-checks": "deno task quality:check:heavy",
    "sbom:source": "deno run --allow-read --allow-write --allow-env --allow-run=syft .tools/generate-sbom.tool.ts source",
    "sbom:check": "deno task sbom:source && trivy sbom --config .config/trivy.yaml --scanners vuln --severity HIGH,CRITICAL --exit-code 1 .cache/sbom/source.cdx.json",
    "dependencies:checksums:update": "deno task aqua:checksums:update && deno run --allow-read --allow-write --allow-net .tools/update-bootstrap-checksums.tool.ts update",
    "dependencies:checksums:check": "deno task aqua:checksums:check && deno run --allow-read --allow-net .tools/update-bootstrap-checksums.tool.ts check",
    "stylelint": "stylelint \"packages/**/*.{css,scss}\" \".config/**/*.{css,scss}\" \".tools/**/*.{css,scss}\" \".local/**/*.{css,scss}\" --config .config/stylelint.config.json --allow-empty-input",
    "quality:report": "mkdir -p .cache && (aqua exec -- qlty check --all --no-cache --no-upgrade-check --no-progress --no-fail --sarif > .cache/qlty-report.sarif || test -s .cache/qlty-report.sarif)",
    "aqua:checksums:update": "deno run --allow-read --allow-write --allow-env --allow-run=aqua .tools/update-aqua-checksums.tool.ts update",
    "aqua:checksums:check": "deno run --allow-read --allow-write --allow-env --allow-run=aqua .tools/update-aqua-checksums.tool.ts check",
    "renovate": "mise exec -- node node_modules/.bin/renovate",
    "ast-grep": "bash -lc './node_modules/.bin/ast-grep test --config .config/ast-grep/sgconfig.yml --skip-snapshot-tests && ./node_modules/.bin/ast-grep scan --config .config/ast-grep/sgconfig.yml packages .config .github && ./node_modules/.bin/ast-grep scan --config .config/ast-grep/sgconfig-tools.yml .tools .local/operator'",
    "comments": "deno run --allow-read .tools/check-comments.tool.ts",
    "check:format": "prettier --no-error-on-unmatched-pattern --config .config/prettierrc.json --ignore-path .config/prettierignore --check \"*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \".config/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \".tools/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \".local/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \".github/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \"packages/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \"docs/**/*.md\"",
    "check:lint": "eslint --config .config/eslint.config.mjs --no-warn-ignored --no-error-on-unmatched-pattern \"*.{js,jsx,mjs,ts,tsx}\" \".config/**/*.{js,jsx,mjs,ts,tsx}\" \".tools/**/*.{js,jsx,mjs,ts,tsx}\" \".local/**/*.{js,jsx,mjs,ts,tsx}\" \".github/**/*.{js,jsx,mjs,ts,tsx}\" \"packages/**/*.{js,jsx,mjs,ts,tsx}\" --max-warnings 0",
    "lint:strict": "eslint --config .config/eslint.config.mjs --no-warn-ignored --no-error-on-unmatched-pattern \"*.{js,jsx,mjs,ts,tsx}\" \".config/**/*.{js,jsx,mjs,ts,tsx}\" \".tools/**/*.{js,jsx,mjs,ts,tsx}\" \".local/**/*.{js,jsx,mjs,ts,tsx}\" \".github/**/*.{js,jsx,mjs,ts,tsx}\" \"packages/**/*.{js,jsx,mjs,ts,tsx}\" --max-warnings 0",
    "format": "prettier --no-error-on-unmatched-pattern --config .config/prettierrc.json --ignore-path .config/prettierignore --write \"*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \".config/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \".tools/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \".local/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \".github/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \"packages/**/*.{js,jsx,mjs,ts,tsx,css,scss,json,md}\" \"docs/**/*.md\"",
    "format:check": "deno task check:format",
    "architecture:test": "deno test --allow-all .config/eslint/architecture-plugin.test.mjs",
    "architecture:check": "deno run --allow-read --allow-env .tools/check-architecture.tool.ts",
    "file:conventions": "deno run --allow-read .tools/check-file-conventions.tool.ts",
    "db:format": "deno run --allow-read --allow-write .tools/format-db-migrations.tool.ts --write",
    "db:format:check": "deno run --allow-read .tools/format-db-migrations.tool.ts",
    "db:bootstrap": "deno run --allow-read --allow-write --allow-env --allow-run .local/operator/content/bootstrap-content-db.operator.ts",
    "db:migrate": "deno task db:bootstrap",
    "db:status": "deno task db:bootstrap && dbmate --url sqlite:.cache/content/editorial.sqlite --migrations-dir packages/thedata/dbmate/migrations --no-dump-schema status",
    "database:schema-docs": "deno run --allow-read --allow-write --allow-env --allow-run .tools/generate-schema-docs.tool.ts",
    "content:rebuild": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run .local/operator/content/rebuild-content.operator.ts",
    "content:export": "deno task content:rebuild",
    "content:validate": "deno run --allow-read --allow-env --allow-net .local/operator/content/validate-content.operator.ts",
    "build:check": "deno task build && deno run --allow-read --allow-env .tools/check-build.tool.ts",
    "security:check": "deno run --allow-read --allow-env .tools/check-security.tool.ts",
    "markdownlint": "markdownlint-cli2 README.md .local/README.md 'docs/**/*.md' --config .config/.markdownlint-cli2.jsonc",
    "cspell": "cspell --config .config/cspell.yaml --no-progress",
    "docs:links": "aqua exec -- lychee --config .config/lychee.toml --offline --include-fragments README.md .local/README.md 'docs/**/*.md'",
    "commit:check": "deno run --allow-read --allow-run .tools/check-commits.tool.ts",
    "test": "vitest run --config .config/vite.config.ts",
    "e2e": "playwright test --config .config/playwright.config.ts",
    "lighthouse": "deno run --allow-all npm:@lhci/cli@0.15.1 autorun --config .config/lighthouserc.json",
    "duplication": "jscpd --config .config/.jscpd.json .",
    "dead-code": "knip --config .config/knip.json"
  },
  "allowScripts": ["npm:@ast-grep/cli"]
}
