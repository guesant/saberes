{
  "mode": "strict",
  "threshold": 10,
  "minLines": 20,
  "minTokens": 150,
  "maxGapLines": 1,
  "ignoreIdentifiers": true,
  "ignoreLiterals": true,
  "format": ["typescript", "tsx", "javascript", "jsx", "json"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/public/data/**",
    "**/*.sqlite",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.d.ts",
    "deno.json",
    ".config/**",
    "packages/app/src/composition/**",
    "packages/pkg-tooling-eslint/**",
    "**/src/**/index.ts",
    "**/package-lock.json",
    "**/package.json",
    ".lighthouseci/**"
  ],
  "reporters": ["console", "threshold"]
}
