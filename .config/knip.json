{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".config/vite.config.ts",
    "packages/pkg-tooling/src/tools/**/*.ts",
    "packages/pkg-tooling-eslint/src/**/*.mjs",
    ".local/operator/**/*.ts",
    "packages/app/src/main.component.tsx",
    "packages/app/src/**/*.test.{ts,tsx}"
  ],
  "project": [
    ".config/vite.config.ts",
    "packages/pkg-tooling/src/tools/**/*.ts",
    "packages/pkg-tooling-eslint/src/**/*.mjs",
    ".local/operator/**/*.ts",
    "packages/app/src/**/*.{ts,tsx}",
    "packages/pkg-domain/src/**/*.{ts,tsx}",
    "packages/pkg-application/src/**/*.{ts,tsx}",
    "packages/pkg-adapter-data-v1/src/**/*.{ts,tsx}",
    "packages/pkg-ui/src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "packages/app/src/content/schema.ts",
    "packages/app/src/hooks.ts",
    "packages/app/src/test/setup.test-support.ts",
    "packages/pkg-adapter-data-v1/src/storage/progress.storage.ts"
  ],
  "ignoreDependencies": [
    "@ast-grep/cli",
    "@fontsource/inter",
    "@types/cytoscape",
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "@types/three",
    "workbox-window"
  ]
}
