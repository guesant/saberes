{
    "ci": {
        "collect": {
            "url": ["http://web/"],
            "numberOfRuns": 1,
            "settings": {
                "onlyCategories": [
                    "performance",
                    "accessibility",
                    "best-practices",
                    "pwa"
                ]
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": ["error", { "minScore": 0.8 }],
                "categories:accessibility": ["error", { "minScore": 0.95 }],
                "categories:best-practices": ["error", { "minScore": 0.9 }],
                "categories:pwa": ["error", { "minScore": 0.9 }]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": ".cache/lighthouse"
        }
    }
}
